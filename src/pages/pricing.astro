---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const faqs = [
  {
    q: 'Why is there no public price?',
    a: 'Because the pilot scope changes with channels, integrations, and onboarding. A public number would be a guess. We scope it in one conversation and put the fee in writing before anything starts.',
  },
  {
    q: 'How long is the pilot?',
    a: 'Six weeks, with a 30-minute evidence review each week. The goal is a real decision, not an indefinite trial.',
  },
  {
    q: 'Do we need to replace our CRM?',
    a: 'No. Keep the CRM you have. We start with one integration path or manual/export capture. Replacing the CRM is not a prerequisite, and it is not the first promise.',
  },
  {
    q: 'Which channels are supported?',
    a: 'Authorized voice notes, field debriefs, selected email, and manual uploads. Live WhatsApp capture is not in the base pilot; official API access is a separate gate with its own onboarding and cost.',
  },
  {
    q: 'What about data privacy?',
    a: 'The pilot uses a separate data processing agreement, recorded consent, a defined retention window, and deletion tests. We do not claim NDPR compliance as a badge. We work through the obligations with Nigerian counsel and publish what is implemented.',
  },
  {
    q: 'What happens after the pilot?',
    a: 'If the evidence is there, we agree a paid continuation. If it is not, we stop or narrow. There is no automatic renewal and no annual contract during the pilot.',
  },
  {
    q: 'Is onboarding included?',
    a: 'Yes. Onboarding is part of the pilot fee. We do not hide implementation in a separate surprise line.',
  },
  {
    q: 'Can we start with one team?',
    a: 'Yes. One team, one workflow, six weeks. Expand only if the evidence earns it.',
  },
];
---

<BaseLayout
  title="Pilot program"
  description="A six-week design-partner pilot for Nigerian high-ticket sales teams. Scoped pricing, one workflow, and an evidence-based decision at the end."
>
  <section class="page-hero">
    <div class="shell">
      <Eyebrow>Pilot program</Eyebrow>
      <h1>A pilot, <em>not a promise.</em></h1>
      <p class="lede">
        We are onboarding a small cohort of Nigerian solar and EPC sales teams. The pilot is
        scoped to one team, one workflow, and six weeks—with a real decision at the end.
      </p>
      <div class="hero-actions">
        <Button href="/contact" variant="primary">Apply for the pilot</Button>
        <Button href="/product" variant="ghost">See the workflow</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div>
          <Eyebrow>What you get</Eyebrow>
          <h2>Six weeks of <em>real work.</em></h2>
        </div>
        <p class="lede">
          Not a sandbox demo. We set up the workflow with your team, on your deals, with your
          approval rules—and measure whether it earns a continuation.
        </p>
      </div>

      <div class="pilot-grid" data-reveal>
        <article class="pilot-card">
          <span class="pilot-card__num">01</span>
          <h3>Workflow design</h3>
          <p>We map one deal motion: capture, review, approval, record. No broad rollout.</p>
        </article>
        <article class="pilot-card">
          <span class="pilot-card__num">02</span>
          <h3>Onboarding</h3>
          <p>Users, roles, consent, retention, and one CRM path configured with your lead.</p>
        </article>
        <article class="pilot-card">
          <span class="pilot-card__num">03</span>
          <h3>Capture kit</h3>
          <p>Voice note, field debrief, selected email, or manual upload—whatever fits the field.</p>
        </article>
        <article class="pilot-card">
          <span class="pilot-card__num">04</span>
          <h3>Review &amp; approval</h3>
          <p>Source-linked diffs and exact approvals for outbound messages and high-impact changes.</p>
        </article>
        <article class="pilot-card">
          <span class="pilot-card__num">05</span>
          <h3>Weekly evidence review</h3>
          <p>Usage, correction burden, time saved, safety, and what still does not work.</p>
        </article>
        <article class="pilot-card">
          <span class="pilot-card__num">06</span>
          <h3>Exit pack</h3>
          <p>Your data, your evidence, and a clear recommendation: continue, narrow, or stop.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="shell two-col">
      <div data-reveal>
        <Eyebrow>Who qualifies</Eyebrow>
        <h2>Built for a <em>specific team.</em></h2>
        <ul class="check-list">
          <li>5+ customer-facing reps, with a named sales leader.</li>
          <li>High-ticket deals—solar and EPC first, then adjacent B2B.</li>
          <li>Real deal evidence you are willing to share under consent.</li>
          <li>A problem worth fixing: missed follow-ups, stale records, or handoff loss.</li>
        </ul>
      </div>
      <div data-reveal>
        <Eyebrow>What we ask</Eyebrow>
        <h2>Skin in <em>the game.</em></h2>
        <ul class="check-list">
          <li>A paid six-week pilot, scoped in writing.</li>
          <li>One team and one workflow for the first six weeks.</li>
          <li>A 30-minute weekly review with the sales lead.</li>
          <li>Honest feedback—including “this is not working.”</li>
        </ul>
      </div>
    </div>

    <div class="shell mt-3" data-reveal>
      <div class="callout">
        <strong>Pricing posture.</strong> Per active rep, with a six-seat minimum. The exact fee is
        scoped after the workflow conversation and fixed for the pilot. No annual contract. No
        automatic renewal. If the pilot does not produce measurable value, you do not continue.
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div>
          <Eyebrow>Questions</Eyebrow>
          <h2>The things <em>worth asking.</em></h2>
        </div>
        <p class="lede">
          If a question is missing, email <a class="text-link" href="mailto:hello@klozdesk.com">hello@klozdesk.com</a>.
        </p>
      </div>
      <div data-reveal>
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
