---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import ApprovalReceipt from '../components/ApprovalReceipt.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="Trust & security"
  description="Klozdesk is pre-launch. This page states the controls we are building, the claims we do not make, and how we handle pilot data."
>
  <section class="page-hero">
    <div class="shell">
      <Eyebrow>Trust &amp; security</Eyebrow>
      <h1>Trust is not <em>a badge.</em></h1>
      <p class="lede">
        We are pre-launch. This page states what we have built, what we are testing, and what we
        do not claim. If that sounds unusual for a software website, good.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div data-reveal>
        <Eyebrow>What we do</Eyebrow>
        <h2>Controls, <em>not ornaments.</em></h2>
        <ul class="check-list">
          <li>Every material claim carries a source span and timestamp.</li>
          <li>Every outbound message and high-impact change requires exact human approval.</li>
          <li>Every deal update keeps a before-and-after and an audit trail.</li>
          <li>Tenant boundaries are enforced server-side, not by hiding buttons.</li>
          <li>Consent is recorded before a source enters the workspace.</li>
          <li>Retention, deletion, offboarding, and restore are tested before live use.</li>
          <li>Provider failures and duplicate events are handled as first-class states.</li>
          <li>Security issues are triaged with a written severity and disclosure path.</li>
        </ul>
      </div>
      <div data-reveal>
        <Eyebrow>What we do not claim</Eyebrow>
        <h2>No borrowed <em>trust.</em></h2>
        <ul class="no-list">
          <li>We are not SOC 2 or ISO 27001 certified. Certification is a future decision, not a current fact.</li>
          <li>We do not use “NDPR compliant” as a badge. We work through the obligations with Nigerian counsel and publish what is implemented.</li>
          <li>We do not claim zero hallucinations. We design for visible uncertainty: cite, abstain, or ask a human.</li>
          <li>We are not a Meta Business Partner. WhatsApp access, when added, follows Meta’s official process.</li>
          <li>We are not a payment processor or a bank.</li>
          <li>We do not display customer logos or testimonials we do not have written permission to use.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell trust-grid">
      <div data-reveal>
        <Eyebrow tone="paper">The receipt</Eyebrow>
        <h2>Every action leaves <em>a trail.</em></h2>
        <p class="lede">
          The approval receipt is the product’s trust contract: who proposed what, from which
          source, who approved it, and what happened next.
        </p>
        <p class="trust-foot">
          We do not expose hidden chain-of-thought. We show concise action receipts: source,
          timestamp, model version, tool result, confidence, and approval state.
        </p>
      </div>
      <div data-reveal>
        <ApprovalReceipt />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div>
          <Eyebrow>Data handling</Eyebrow>
          <h2>What happens to <em>your data.</em></h2>
        </div>
        <p class="lede">
          The website and the pilot are different surfaces. We do not blur them.
        </p>
      </div>

      <div class="not-grid" data-reveal>
        <article class="not-card">
          <h3>This website</h3>
          <p>
            We collect only what you choose to send us by email. We do not run advertising
            trackers or sell contact data.
          </p>
        </article>
        <article class="not-card">
          <h3>The pilot</h3>
          <p>
            Pilot customers receive a separate data processing agreement, a recorded consent
            flow, a defined retention window, and deletion tests.
          </p>
        </article>
        <article class="not-card">
          <h3>Model training</h3>
          <p>
            Customer recordings are not reused for unrelated model training by default. Any
            evaluation use is explicit, bounded, and consented.
          </p>
        </article>
        <article class="not-card">
          <h3>Subprocessors</h3>
          <p>
            We list hosting, storage, transcription, model, and email providers before onboarding.
            Cross-border transfer terms are reviewed before pilot data enters the system.
          </p>
        </article>
      </div>

      <div class="callout mt-2" data-reveal>
        <strong>Report a security issue.</strong> Email
        <a href="mailto:hello@klozdesk.com?subject=Security%20report">hello@klozdesk.com</a> with
        “Security” in the subject. Include the affected URL, a description, and a safe way to
        reproduce it. Do not include customer data.
      </div>

      <div class="mt-2" data-reveal>
        <Button href="/contact" variant="primary">Talk to us about the pilot</Button>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
