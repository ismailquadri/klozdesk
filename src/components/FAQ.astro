---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary>
        {item.q}
        <span aria-hidden="true">+</span>
      </summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
